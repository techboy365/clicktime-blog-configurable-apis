{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clicktime-blog",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clicktime-blog-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SCAN_QUEUE",
        "queue": "clicktime-blog-scans"
      }
    ],
    "consumers": [
      {
        "queue": "clicktime-blog-scans",
        "max_batch_size": 1,
        "max_retries": 5,
        "dead_letter_queue": "clicktime-blog-scans-dlq"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "CLICK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "SUBSCRIBE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SEND_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 2, "period": 60 }
    }
  ],
  "vars": {
    "URLSCAN_API_URL": "https://urlscan.io/api/v1",
    "WEBRISK_API_URL": "https://webrisk.googleapis.com/v1/uris:search",
    "RESEND_API_URL": "https://api.resend.com/emails",
    "JOESANDBOX_API_URL": "https://jbxcloud.joesecurity.org/api",
    "URLSCAN_CLEAN_CACHE_SECONDS": "300",
    "SCAN_JOB_MAX_WAIT_MS": "900000",
    "ADMIN_USER": "editor"
  },
  "observability": {
    "enabled": true
  }
}